# Copy to .env or just run ./install.sh, which writes .env for you.
# Secrets stay in .env (mode 600). Do not commit that file.

PUID=1000
PGID=1000
TZ=America/New_York

CONFIG_DIR=./config
MEDIA_DIR=./media
DOWNLOAD_DIR=./downloads

# One login for Jellyfin, Seerr, Sonarr, Radarr, Prowlarr, and qBittorrent.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

JELLYFIN_PORT=8096
QBIT_PORT=8080
PROWLARR_PORT=9696
FLARESOLVERR_PORT=8191
SONARR_PORT=8989
RADARR_PORT=7878
SEERR_PORT=5055

# 1 tunnels qBittorrent, Prowlarr, and FlareSolverr through Gluetun.
# 0 publishes those services directly. Downloads are not tunneled in that mode.
USE_VPN=1
VPN_SERVICE_PROVIDER=ivpn
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Optional Gluetun settings. The prefix is stripped, so
# GLUETUN_SERVER_COUNTRIES=Netherlands becomes SERVER_COUNTRIES.
# GLUETUN_SERVER_COUNTRIES=

# How Jellyfin is reached from outside this computer:
# local, cloudflare, forward, or tailscale.
# tailscale needs no domain and no open router port.
# ./install.sh asks when this is unset. --yes stays on local until you pass --remote.
REMOTE_ACCESS=local

# Cloudflare Tunnel. The domain must already be Active on Cloudflare.
# Create a token at https://dash.cloudflare.com/profile/api-tokens with:
#   Account / Cloudflare Tunnel / Edit
#   Zone / DNS / Edit
#   Zone / Zone / Read
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_HOSTNAME=watch.example.com
# CLOUDFLARE_SEERR_HOSTNAME=requests.example.com
# CLOUDFLARE_ACCOUNT_ID=
# A connector token from the dashboard can be used instead of the API token:
# CLOUDFLARE_TUNNEL_TOKEN=
